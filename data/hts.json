{
  "_meta": {
    "source": "USITC Harmonized Tariff Schedule",
    "release": "2026HTSRev4",
    "api_base": "https://hts.usitc.gov/reststop",
    "endpoints": {
      "search": "GET /search?keyword={term}",
      "rates": "GET /getRates?htsno={htsno}&keyword={term}",
      "current_release": "GET /currentRelease"
    },
    "note": "No bulk download available. App uses live API with 24-hour in-memory cache."
  },
  "_schema": {
    "htsno": "string — full HTS code e.g. '8471.30.01.00'",
    "description": "string — product description",
    "general": "string — MFN duty rate e.g. 'Free', '3.3%', '15¢/kg + 6.5%'",
    "special": "string — FTA preferential rates e.g. 'Free (A,AU,BH,CL,CO,KR,...)'",
    "other": "string — Column 2 (non-MFN) rate",
    "units": "array — unit of quantity",
    "indent": "string — hierarchy indent level",
    "general_rate": "float — parsed MFN rate as percentage (null if unparseable)"
  },
